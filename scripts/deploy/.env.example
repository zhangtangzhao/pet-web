# 复制为 .env（docker compose 自动读取同目录 .env），值会注入 api 容器展开 config/pet-api.yaml 中的 ${VAR} 占位符
# 生产环境必须修改所有默认值

# ── 运行模式 ──
# dev / test / pro；生产必须为 pro（此时测试公共验证码强制失效，且关键配置缺失会拒绝启动）
APP_MODE=dev

# ── JWT 双端密钥（生产必须替换为随机长字符串，如 openssl rand -hex 32）──
AUTH_MEMBER_SECRET=
AUTH_ADMIN_SECRET=

# ── 数据库 / 缓存 ──
POSTGRES_PASSWORD=pet_dev_123
REDIS_PASSWORD=redis_dev_123

# ── 微信登录（小程序 + 公众号 H5）──
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
WECHAT_H5_APPID=
WECHAT_H5_SECRET=

# ── 微信支付 V3 ──
WECHATPAY_MCH_ID=
WECHATPAY_APIV3_KEY=
WECHATPAY_SERIAL_NO=
WECHATPAY_NOTIFY_URL=

# ── 短信 ──
SMS_PROVIDER=                  # aliyun / tencent，留空不发真实短信（验证码见服务日志）
SMS_TEST_CODE=888888           # 测试公共验证码，仅 APP_MODE != prod 生效；生产必须留空

# ── 腾讯云 COS ──
COS_BUCKET=                    # bucket-appid
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=

# ── AI 智能客服（OpenAI 兼容接口，三项全填即启用；如 DeepSeek）──
AI_BASE_URL=                   # 如 https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=                      # 如 deepseek-chat

# ── 微信通知模板（客服回复离线提醒 + 订单事件 + 券到期提醒；留空则通知降级为仅落库留痕）──
WX_MINI_TMPL_CS_REPLY=         # 小程序订阅消息模板 ID
WX_MINI_TMPL_ORDER=
WX_MINI_TMPL_COUPON=
WX_H5_TMPL_CS_REPLY=           # 公众号模板消息 ID
WX_H5_TMPL_ORDER=
WX_H5_TMPL_COUPON=

# ── 监控（Grafana 管理员密码；入口 http://主机:3001，数据源指向 prometheus:9090）──
GRAFANA_ADMIN_PASSWORD=admin   # 生产必须修改
